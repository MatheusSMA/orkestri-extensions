{
  "id": "orkestri.vscodium",
  "name": "VSCodium",
  "version": "1.0.0",
  "publisher": "orkestri",
  "description": "VSCodium, the open-source build of VS Code (MIT), as its own window inside a card: no server. The first start downloads the portable VSCodium 1.143.17232 for Windows x64 (221 MB) from its GitHub release, checked against the pinned sha256.",
  "minAppVersion": "0.1.0",
  "kinds": ["app"],
  "permissions": ["process", "network", "files"],
  "contributes": {
    "apps": [
      {
        "id": "vscodium",
        "name": "VSCodium",
        "icon": "code",
        "window": true,
        "download": {
          "url": "https://github.com/VSCodium/vscodium/releases/download/1.143.17232/VSCodium-win32-x64-1.143.17232.zip",
          "sha256": "a1090868af8ac0ac04c22d79fdd02246fa115a78daf38a741d8db06df1753c1d",
          "size": 231406156,
          "version": "1.143.17232"
        },
        "command": "${appPath}/VSCodium.exe",
        "args": ["--disable-features=CalculateNativeWinOcclusion"],
        "env": { "VSCODE_PORTABLE": "${dataPath}" },
        "defaults": "defaults",
        "openFolder": ["--reuse-window", "${folder}"]
      }
    ]
  }
}
