{
  "id": "orkestri.warp-oss",
  "name": "Warp (open-source build)",
  "version": "1.0.0",
  "publisher": "orkestri",
  "description": "Warp's open-source terminal client as its own window inside a card, one per card, its settings and data in the card's folder; linked terminals type command lines into it. Built by Orkestri from warpdotdev/warp's AGPL source; not made or endorsed by Warp. Installing it downloads that build (169 MB, a release of orkestri-extensions that also holds its source, checked against the pinned sha256). No account needed for the terminal.",
  "minAppVersion": "0.1.7",
  "icon": "icon.png",
  "kinds": [
    "app"
  ],
  "permissions": [
    "process",
    "network",
    "files"
  ],
  "agents": {
    "manual": "AGENTS.md"
  },
  "contributes": {
    "apps": [
      {
        "id": "warp",
        "name": "Warp OSS",
        "icon": "square-terminal",
        "window": true,
        "download": {
          "url": "https://github.com/MatheusSMA/orkestri-extensions/releases/download/warp-oss-2c01ad402d83-3/warp-oss-windows-x64-2c01ad402d83.zip",
          "sha256": "c76d6f8d2344f8d9f354cd1f5a299fc0f9fe5030aa4a5468013d4f4b1ca4d764",
          "size": 169420829,
          "version": "2c01ad402d83"
        },
        "command": "${appPath}/warp-oss.exe",
        "env": {
          "WARP_DATA_ROOT": "${instancePath}/warp",
          "WARP_DATA_PROFILE": "${instance}"
        },
        "zoom": {
          "file": "warp/config/settings.toml",
          "sizes": {
            "appearance.text.font_size": 13
          }
        },
        "typeRun": true,
        "defaults": "defaults"
      }
    ]
  }
}
