{
  "id": "orkestri.vscodium",
  "name": "VSCodium",
  "version": "1.3.0",
  "publisher": "orkestri",
  "description": "VSCodium, the open-source build of VS Code (MIT), as its own window inside a card, one per card; linked terminals drive it (orkestri code). Installing it downloads the portable VSCodium 1.143.17232 for Windows x64 (221 MB) from its GitHub release, checked against the pinned sha256. When the computer already has it installed, that install is used and nothing is downloaded.",
  "minAppVersion": "0.1.8",
  "icon": "icon.png",
  "kinds": ["app"],
  "permissions": ["process", "network", "files"],
  "agents": { "manual": "AGENTS.md" },
  "contributes": {
    "apps": [
      {
        "id": "vscodium",
        "name": "VSCodium",
        "icon": "code",
        "window": true,
        "download": {
          "url": "https://github.com/VSCodium/vscodium/releases/download/1.143.17232/VSCodium-win32-x64-1.143.17232.zip",
          "sha256": "a1090868af8ac0ac04c22d79fdd02246fa115a78daf38a741d8db06df1753c1d",
          "size": 231406156,
          "version": "1.143.17232"
        },
        "command": "${appPath}/VSCodium.exe",
        "installed": ["{LocalAppData}\\Programs\\VSCodium", "{ProgramFiles}\\VSCodium"],
        "args": ["--disable-features=CalculateNativeWinOcclusion", "--extensions-dir", "${dataPath}/extensions", "${folder}"],
        "env": { "VSCODE_PORTABLE": "${instancePath}" },
        "defaults": "defaults",
        "openFolder": ["--reuse-window", "${folder}"],
        "controller": "bridge",
        "setup": [
          {
            "command": "${appPath}/VSCodium.exe",
            "args": ["${appPath}/resources/app/out/cli.js", "--extensions-dir", "${dataPath}/extensions", "--install-extension", "${extensionPath}/bridge.vsix", "--force"],
            "env": { "ELECTRON_RUN_AS_NODE": "1", "VSCODE_PORTABLE": "${dataPath}" }
          }
        ]
      }
    ]
  }
}
